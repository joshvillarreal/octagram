{
  "name": "octagram-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc --noEmit && vite build && node scripts/prepare-pages.mjs",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "package:site": "node scripts/package-site.mjs",
    "release": "npm run test && npm run build && npm run package:site"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.5.0",
    "typescript": "~5.9.2",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
